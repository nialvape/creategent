# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch / debug output
gen*.txt
plan*.txt
pid*.txt
proj*.json
*.wav

# python
__pycache__/
*.pyc

# Copied out of the repo root by beam/comfy/app.py at deploy time, because Beam
# syncs only the deploy directory. The root copy is the source of truth.
beam/comfy/comfy_worker/

# Written by scripts/ingest_workflow.py --download, regenerated every run.
beam/models/manifest.json
